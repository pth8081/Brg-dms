DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=dms_db
DB_PORT=3306

PORT=3000
NODE_ENV=production

# Số tiến trình worker chạy song song (tận dụng nhiều lõi CPU). Để trống
# hoặc =1 để chạy 1 tiến trình duy nhất (mặc định, an toàn cho máy nhỏ/dev).
# Đặt >1 để bật cluster — xem DEPLOYMENT.md mục "Cluster nhiều worker" để
# biết cách chọn số worker phù hợp và chỉnh DB_CONNECTION_LIMIT tương ứng.
WEB_CONCURRENCY=1

# Số kết nối CSDL tối đa cho MỖI tiến trình (worker). Khi chạy cluster,
# tổng số kết nối tới MariaDB xấp xỉ WEB_CONCURRENCY x DB_CONNECTION_LIMIT —
# phải nhỏ hơn max_connections của MariaDB. Xem DEPLOYMENT.md.
DB_CONNECTION_LIMIT=60

# Bắt buộc đặt cố định cho production — nếu bỏ trống, server sẽ tự sinh secret
# ngẫu nhiên mỗi lần khởi động (mọi phiên đăng nhập cũ sẽ mất hiệu lực khi restart).
JWT_SECRET=

# Danh sách origin được phép gọi API cross-origin, phân tách bởi dấu phẩy.
# Để trống nếu frontend luôn được phục vụ cùng origin với API (mặc định, khuyên dùng).
CORS_ORIGIN=

# Đặt true nếu server chạy sau reverse proxy (Nginx/Load Balancer) để nhận đúng IP client.
TRUST_PROXY=false

# Thư mục lưu file PDF tài liệu trên đĩa server (KHÔNG còn lưu trong CSDL).
# Mặc định là thư mục uploads/ trong mã nguồn nếu để trống. Nên đặt đường dẫn
# tuyệt đối ra ngoài thư mục mã nguồn cho production, và nhớ backup thư mục
# này cùng với CSDL.
UPLOAD_DIR=

# Dung lượng tối đa cho mỗi file PDF khi tải lên, tính bằng MB. Mặc định 20.
MAX_PDF_SIZE_MB=20
