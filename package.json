{
  "name": "dms-system-production",
  "version": "6.20.0",
  "description": "Hệ thống Quản lý Tài liệu DMS Production (Express & MySQL)",
  "main": "server.js",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/style.css --minify",
    "build:vendor": "cp node_modules/exceljs/dist/exceljs.min.js public/vendor/exceljs.min.js",
    "prestart": "npm run build:css && npm run build:vendor",
    "start": "node server.js",
    "migrate:legacy-files": "node migrate-legacy-files-to-disk.js",
    "migrate:legacy-files:dry-run": "node migrate-legacy-files-to-disk.js --dry-run"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "^9.0.0",
    "multer": "^2.2.0",
    "mysql2": "^3.9.2",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "exceljs": "^4.4.0",
    "tailwindcss": "^4.3.3"
  }
}
